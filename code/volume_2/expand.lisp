;;; This is part of the KBE.  That is its excuse for having sixes
;;; in front of everything.  It can also stand alone as a sort of
;;; super macroexpander.

(declare (special DEFINING-CODE K*PROG-STACK))

;;; In order to simplify the task of making surface plans for programs
;;; the following defines constructs which embody all of the
;;; key features of sequential programming in LISP and FORTRAN.
;;; They have all of the features found in LAMBDA, PROGN, PROG, LET, COND,
;;; AND, OR, MAPCAR, DO, (and _SUBROUTINE, _FUNCTION, _IF) etc.
;;; THEY ARE THE ONLY FEXPRS THAT THE REST OF THE SYSTEM EVER
;;; HAS TO DEAL WITH.

;;; Everything in this file revoles around these fexprs (called 6fexprs).
;;; They are: K*LAMBDA, K*PROG, K*GO, K*TAG, K*IFNULL, K*IF,
;;; K*PSETQ, and K*QUOTE
;;; (STRING for cobol), (_LT, _EQ, _GT for fortran).

;;; (K*LAMBDA return? invars body) where
;;;     return? - is non nil if the value of the body is to be returned
;;;               as a return
;;;               value (as in lisp).
;;;     invars - are a list of input variables a la lambda (but note that
;;;              like fortran if you setq one of these variables,
;;;              then it becomes an OUTPUT as well as an input).
;;;     body - is a single form whose value is the return value (if any).
;;;            In general, the body will be a call on K*PROG
;;;   It is expected that the outermost form of a fn being defined will
;;;   be a K*LAMBDA, and that there will not be any internal K*LAMBDAs.
;;; (K*PROG boundvars statement*n ret-vars)   where
;;;     boundvars - are a list of var value pairs a la let (the values are
;;;                 evaluated before the boundvars are bound.)
;;;                 (Note that these are not inputs, and assigning to
;;;                 them doesn't effect anything on the outside.)
;;;     statement - is any lisp form.
;;;                 the value of the last form is returned.
;;;     ret-vars  - is a list of zero or more variables who's values are
;;;                 returned multiplely.  only zero and one are
;;;                 supported now.
;;;   Free variables can be set and read anywhere in a K*PROG.
;;;   The following special forms can appear in a K*PROG
;;; (K*TAG lab) is a label
;;; (K*GO lab) branches to lab unconditionally
;;; (K*IFNULL sexp lab) branches iff sexp is null.
;;; (K*IF sexp lab) branches iff sexp is not null.
;;;   the reason we have two of these
;;;   is so that we don't ever have to have a NOT.
;;; [_lt _eq _gt are additional predicates used by fortran]

;;; (K*QUOTE form) is normal lisp quote.
;;;   Note that to further simplify things,
;;;   expand-special-forms makes sure that every thing that gets
;;;   evaluated to itself (eg numbers) is wrapped in an explicit K*QUOTE.
;;; (STRING atom) is an additional quoter used by cobol.
;;; (K*PSETQ atom sexp atom sexp ...) is normal lisp PSETQ.

;;; (K*SLOT form slotname slottype)
;;; instances of kbe-/#-comment-macro all get turned into segments
;;; and further processing happens on them as if they were simple
;;; funcalls.  The form is a call on the function nil
;;; if there is no code.  If the code is a variable then it is a
;;; call on 5variable.  Otherwise it is the code.

;;; The following k*expanders convert every fexpr that can occure in an
;;; input program into code using only the 6FEXPRs.
;;; Each k*expander expects a single arg: the entire form to be redone.
;;; It returns an entire new form to evaluate.  The original code is
;;; not side-effected, but neither is it copied.

;;; The variable names which are generated by k*expanders, and therefore
;;; should not be used as guides for names to be created by the coder,
;;; begin with "_" to signal this fact.

;;; This fn is called with a form to translate that entire form into the
;;; 6fexprs.
;;; Note that it relies on the fact that every fexpr in the input
;;; must have a k*expander associated with it that tells how to translate it
;;; into terms of the 6fexprs.  As a result the only fexprs that
;;; expand-special-forms actually has to understand are the 6fexprs.
;;; Macros are expanded fully but substs are not.

;;; Note that everything is set up so that the original form is not
;;; side-effected, but so that there is maximal sharing between the
;;; result, and the original form.
;;;
;;; Note that macroexpansion is done only AFTER k*expanders are checked
;;; for, so that a k*expander can override a macro definition.

;;; also note that anything that conses up any of the K* things is
;;; reponsible for calling expand-special-forms on anything put
;;; inside the k* thing.

;;; It rebinds DEFINING-CODE so that the file can stand alone.

(defun expand-special-forms (form)
  (let ((DEFINING-CODE form))
    (cond ((self-evalling-form form) form)
          ((symbolp form) form)         ;Variable reference
          ((symbolp (car form))         ;Function application
           (cond ((get (car form) '6fexpr) form)      ;K* things
                 ((get (car form) 'k*expander)
                  (expand-special-forms
                    (funcall (get (car form) 'k*expander) form)))
                 ((not (eq form
                           (setq form (macroexpand-1-no-substs form))))
                  (expand-special-forms form))
                 (t (let ((x `(,(car form)
                               ,@(mapcar #'expand-special-forms
                                         (cdr form)))))
                      (cond ((equal x form) form)     ;Maximize sharing
                            (t x))))))
          ((6lambda-like-fn? (car form))      ;Expand inline lambdas
           (expand-special-forms (inline-lambda-k*expander form)))
          (t (barf "EXPAND-SPECIAL-FORMS: Cannot handle form.~% Form: ~:="
                   form)))))

(defun self-evalling-form (form)
  (or (memq form '(t nil))
      (numberp form)
      (stringp form)))

;;; Is a function a literal lambda or relative?
(defun 6lambda-like-fn? (fn)
  (and (listp fn)
       (memq (car fn) '(lambda named-lambda subst named-subst))))

;;; This is copied from lispm;qfctns.  The only difference is that
;;; it does not expand substs, which are functions so far as the
;;; PA is concerned.
(defun macroexpand-no-substs (macro-call &optional ignore)
    (do ((tm macro-call (macroexpand-1-no-substs tm))
         (otm nil tm))
        ((or (eq tm otm) (atom tm)) tm)))

(defun macroexpand-1-no-substs (macro-call &optional ignore)
    (prog (tm)
          (and (atom macro-call) (return macro-call))
          (cond ((not (atom (car macro-call)))
                 (return macro-call))
                ((not (symbolp (car macro-call))))
                ((setq tm (si:declared-definition (car macro-call)))
                 (return (cond ((atom tm) macro-call)
                               ((eq (car tm) 'macro)
                                (funcall (cdr tm) macro-call))
                               (t macro-call))))
                ((setq tm (si:open-code-p (car macro-call)))
                 (return (cons tm (cdr macro-call)))))
          (return macro-call)))

;this is called below in order to determine whether a piece of code
;is actually in the orginal form or not.

(defun 6good-code (form)
  (if (6is-in form DEFINING-CODE) (ncons form)))

;note this only checks for things that are cars of things.

(defun 6is-in (form list)
  (cond ((eq form list))
        ((listp list)
         (or (6is-in form (car list)) (6is-in form (cdr list))))))

;this is used by the analyzer instead of the true definition.
;the problem is that it cannot deal with the file-closes in loop fragments.
;the file-opens must stay so that cliches with
;file-name roles will have boxes for them to point to.

(defun (with-open-file k*expander) (form)
  (let (((nil (file path-name mode) . body) form))
    `(let ((,file (with-open-file-open ,path-name ,mode)))
       .,body)))

;;; These are the k*expanders for LISP
;;;this isn't acrually used anymore.  Defuns are parsed by flow-analyze.
(defun (:property defun k*expander) (form)
  (let* ((good (si:defun-compatibility (cdr form))))
    (si:process-defun-body (cadr good) (cddr good))))

;;; This is a macro, but we override the macroexpansion.
(defun (:property defsubst k*expander) (form)
  (warn "DEFSUBST will be turned into a DEFUN")
  (funcall (get 'defun 'k*expander) form))

;this handles the new style slot comment things
;note that compound names are just made into one big name
;and processed completely only when the analyzer is done.
;Note that THEs are optional in the comment.  Note that we
;cons up a list with function NIL if there is no code.

(defun (:property kbe-/#-comment-macro k*expander) (form)
  (let* (((code com) (cdr form))
         (names (Rlist (filterS #'(lambda (x)
                                    (not (string-equal x "the")))
                                (Elist com))))
         (body (cond ((null code) (list nil))
                     ((and (listp (car code)) (eq (caar code) '...))
                      (cons nil (cdar code)))
                     ((not (garden-variety-fn-apply (car code)))
                      (cons '5noop code))
                     (T (car code))))
         (slottype (cond ((string-equal (car names) "input")
                          (pop names)
                          'input)
                         ((string-equal (car names) "output")
                          (if (eq (car body) nil)
                              (barf "Output slot has no source: ~S" form))
                          (pop names)
                          'output)
                         (T 'segment)))
         (slotname (cond ((null names) (barf "Slot with no name: ~S" form))
                         ((intern (format nil "~{~A~^-~}" names)
                                  *kbe-package*)))))
    `(K*SLOT ,(expand-special-forms body) ,slotname ,slottype)))

;this checks that we have a simple function that won't blow up when
;we directly instantiate it later -- see (K*SLOT 6FEXPR)

(defun garden-variety-fn-apply (call)
  (and (listp call)
       (symbolp (car call))
       (null (get (car call) 'k*expander))))

;;; Sequential setq is turned into a series of k*psetq forms.
;;; Note that (setq) => nil and (setq foo bar baz) sets baz to nil.

(defun (:property setq k*expander) (body)
  (setq body (cdr body))
  (cond ((null body) nil)
        ((null (cddr body))
         `(k*psetq ,(car body) ,(expand-special-forms (cadr body))))
        (t `(progn ,@(do ((body-iter body (cddr body-iter))
                          var val k*psetqs)
                         ((null body-iter) (nreverse k*psetqs))
                       (setq var (car body-iter) val (cadr body-iter))
                       (push `(k*psetq ,var ,(expand-special-forms val))
                             k*psetqs))))))

(defun (quote k*expander) (form)
  `(K*QUOTE ,@(cdr form)))

;this is a pretty cludgy treatment of setf that
;works in the current demo.  It just makes setf
;act like a normal function.

(defun (setf k*expander) (form)
  (let* (((accessor value) (cdr form))
         access-list var)
    (prog ()
      L (when (symbolp accessor) (setq var accessor) (return nil))
        (if (or (not (listp accessor))
                (not (listp (cdr accessor)))
                (cddr accessor))
            (barf "Cannot handle complex SETF: ~A" form))
        (push (car accessor) access-list)
        (setq accessor (cadr accessor))
        (go L))
    (setq access-list (reverse access-list))
    `(k*setf ',access-list ,var ,value)))

;this makes it so that things print out again as a setf.

(pp:define-list-print-function k*setf (form s)
  (let* ((((nil access-list) var value) (cdr form))
         (accessor (reduceS #'(lambda (x y) (list y x))
                            var
                            (Elist (reverse access-list)))))
    (format s "~=" `(setf ,accessor ,value))))

;;; Cond.

(defconst 6used-temp nil
  "Tells whether the variable _cond-temp has been used in a cond.")

;;; Wrap a PROG around the body.  Bind _cond-ret and also
;;; _cond-temp if 6used-temp.

(defun (:property cond k*expander) (clauses)
  (setq clauses (cdr clauses))
  (let* ((6used-temp nil)
         (body (cond-k*expander1 clauses)))
    `(prog T (_cond-ret ,@(if 6used-temp '(_cond-temp)))
       ,@body
       (return-from T _cond-ret))))

;;; Recursively build prog body.  Each clause gets a tag, which is
;;; an _ gensym, or _cond-end after the last one.

(defun cond-k*expander1 (clauses)
  (cond ((null clauses) nil)
        (t (let* ((next (cond ((null (cdr clauses)) '_cond-end)
                              (t (gensym '_)))))
             `(,@(cond-k*expander-clause
                   (car clauses) next (null (cdr clauses)))
               ;; Goto end if fails.
               ,@(if (cdr clauses) '((go _cond-end)))
               ,next
               ,@(cond-k*expander1 (cdr clauses)))))))

;;; This produces the inline code for a clause.
;;; Much hair is required to determine what the return value is.

(defun cond-k*expander-clause (clause next last-clause?)
  (cond ((null clause) nil)
        ((null (cdr clause))
         (cond ((or last-clause? (eq (car clause) 't))
                `((setq _cond-ret ,(car clause))))
               ((atom (car clause))
                `((k*ifnull ,(car clause) ,next)
                  (setq _cond-ret ,(car clause))))
               (t ;;(not (atom (car clause)))
                ;; Note we never want to have dflow from a pred when we
                ;; don't absolutely have to.
                (setq 6used-temp t)
                `((setq _cond-temp ,(car clause))
                  (k*ifnull _cond-temp ,next)
                  (setq _cond-ret _cond-temp)))))
        (t `(,@(6and-pred (car clause) next)
             (setq _cond-ret
                   ,(cond ((null (cddr clause)) (cadr clause))
                          (t `(progn ,@(cdr clause)))))))))

;; the point of all this hair is to get rid of calls on
;; NOT so that the coder will have greater freedom
;; in the end.  this is possible because the presence of nots
;; can be encoded based on whether the basic pred k*if is used
;; rather than k*ifnull.  Also the following is simplified because
;; it is only called when the value of the expression is not going to
;; be used.  this simplifies everything.
;;  Note that NULL is not treated specially, IE every instance
;; of NULL used by the user will always stay around.

(defun 6and-pred (pred next)
  (cond ((eq pred 't) nil)
        ((atom pred) `((k*ifnull ,pred ,next)))
        ((memq (car pred) '(not)) (6or-pred (cadr pred) next))
        ((eq (car pred) 'and)
         (do ((things (cdr pred) (cdr things))
              (result nil))
             ((null things) result)
           (setq result (append result (6and-pred (car things) next)))))
        ((eq (car pred) 'or)
         (let ((this (gensym '_)))
           `(,@(do ((things (cdr pred) (cdr things))
                    (result nil))
                   ((null things) result)
                 (setq result
                       (append result (6or-pred (car things) this))))
             (go ,next) ,this)))
        (t `((k*ifnull ,(expand-special-forms pred) ,next)))))

(defun 6or-pred (pred this)
  (cond ((eq pred 't) `(go ,this))
        ((atom pred) `((k*if ,pred ,this)))
        ((memq (car pred) '(not)) (6and-pred (cadr pred) this))
        ((eq (car pred) 'or)
         (do ((things (cdr pred) (cdr things))
              (result nil))
             ((null things) result)
           (setq result (append result (6or-pred (car things) this)))))
        ((eq (car pred) 'and)
         (let ((next (gensym '_)))
           `(,@(do ((things (cdr pred) (cdr things))
                    (result nil))
                   ((null things) result)
                 (setq result
                       (append result (6and-pred (car things) next))))
             (go ,this) ,next)))
        (t `((k*if ,(expand-special-forms pred) ,this)))))

;;; note that the key difficulties here are dealing with names, and
;;; multiple return values.  the named KBE-PROG-NAMED is used to fill
;;; a logical gap and simplify things.

;;; each entry on K*PROG-STACK is of the form (name tag ret-vars)
;;; if there is any return, then the tag is set up.  if there are
;;; any return values, then the ret-vars are set up for the
;;; maximum number possible.

;;; note that in order to handle infinite loops we insert a pseudo exit
;;; here which stays in the plan up till the very end of the analysis
;;; phase.  This keeps the cflow complete through these stages.
;;; the pseudo exit is then deleted.

(defun (:property kbe-prog-named k*expander) (form)
  (let* ((name (second form))
         (var-vals (third form))
         (body (rest3 form))
         (inits
           (mapcar #'(lambda (x)
                       (cond ((symbolp x) (list x nil))
                             (T (list (car x)
                                      (expand-special-forms (cadr x))))))
                   var-vals))
         (K*PROG-STACK (cons (list name nil) K*PROG-STACK))
         (exprs (mapcar #'(lambda (x)
                            (cond ((symbolp x) `(k*tag ,x))
                                  (T (expand-special-forms x))))
                        body)))
    (cond ((null (cadar K*PROG-STACK))
           (if (not (and (listp (car (last body)))      ;kludge to detect
                         (eq (caar (last body)) 'go)))  ;infinite loops
               (barf "Odd no exit loop ~:=" form))
           (let ((tag (gensym '_)))
             (rplaca (cdar K*PROG-STACK) tag)
             (setq exprs
                   `(,@(nreverse (cdr (reverse exprs)))
                     (k*infinite-loop-pseudo-exit ,tag)
                     ,@(last exprs))))))
    `(k*prog (,@inits
              ,@(mapcar #'(lambda (x) (list x nil))
                        (cddar K*PROG-STACK)))
       ,@exprs
       (k*tag ,(cadar K*PROG-STACK))
       ,(reverse (cddar K*PROG-STACK)))))

;;; Anyone care to explain how the hell this works?
(defun (:property return-from k*expander) (form)
  (let* ((name (second form))
         (exprs (rest2 form))
         (entry (assq name K*PROG-STACK)))
    (cond ((null entry)
           (barf "Return not inside PROG or DO~% Form: ~S" form))
          ((cdr exprs)
           (barf "More than one return val not supported yet~% Form: ~S"
                 form)))
    (let* ((tag (or (cadr entry) (gensym '_)))
           (vars (cddr entry)))
      (prog1
        `(k*prog nil
           ,@(do ((expr-iter exprs (cdr expr-iter))
                  (var-iter (reverse vars) (cdr var-iter))
                  var
                  expanded-expr
                  (result nil))
                 ((null expr-iter) result)
               (setq expanded-expr (expand-special-forms (car expr-iter))
                     var (car var-iter))
               (push (cond ((and (listp expanded-expr)
                                 (eq (car expanded-expr) 'k*prog)
                                 (null (car (last expanded-expr)))
                                 (null (cdr exprs)))
                            expanded-expr)
                           (t (cond ((null var)
                                     (push (setq var (gensym '_)) vars)))
                              `(k*psetq ,var
                                        ,(expand-special-forms
                                           (car expr-iter)))))
                     result))
           (k*go ,tag)
           nil)
        (rplaca (cdr entry) tag)
        (rplacd (cdr entry) vars)))))

(defun (:property go k*expander) (form)
  (cond ((and (= (length form) 2) (symbolp (cadr form)))
         `(k*go ,(cadr form)))
        (t (barf "Bad GO statement~% Form: ~S" form))))


;the following makes simple cases of LOOP work.  Note that you can only
;use complex cases in complete programs, and the coder never makes them.
;we need this to interface correctly with the way we cludge PROG above.

(defun (:property loop k*expander) (form)
  (let ((body (cdr form)))
    (if (and (symbolp (car body)) (string-equal (car body) 'do))
        (pop body))
    (if (Rand-fast (listp (Elist body)))
        `(prog () L ,@ body (go L))
        (macroexpand-1 form))))

;;; Note how this prevents setqs to the inputs from being propogated to
;;; the outside, while side-effects to them are propagated within
;;; Handles only the &aux keyword for now.
;;; this is only intended to be called on top level forms.

(defmacro def-lambda-like-k*expander (name named?)
  `(defun (:property ,name k*expander) (form)
     (let* ((vars ,(cond (named? '(third form)) (t '(second form))))
            (body ,(cond (named? '(nthcdr 3 form)) (t '(nthcdr 2 form))))
            (local-vars (cdr (memq '&aux vars)))
            (invars (cond (local-vars
                           (reverse (cdr (memq '&aux (reverse vars)))))
                          (T vars))))
       `(k*lambda t ,invars
          ,(expand-special-forms
             `(prog T (,@(mapcar #'(lambda (var) (list var var))
                                 invars)
                       ,@(mapcar #'(lambda (var) (list var nil))
                                 local-vars))
                ,@(nreverse (cdr (reverse body)))
                (return-from T ,@(last body))))))))

(def-lambda-like-k*expander lambda nil)
(def-lambda-like-k*expander subst nil)
(def-lambda-like-k*expander named-lambda t)
(def-lambda-like-k*expander named-subst t)

;;; This handles all nested applications such as those created by LET.

(defun inline-lambda-k*expander (form)
  (let* ((vars (arglist (car form)))
         (body (cond ((memq (caar form) '(lambda subst)) (cddr (car form)))
                     (t (cdddr (car form)))))
         (vals (cdr form))
         (vars-vals
           (do ((vars-iter vars (cdr vars-iter))
                (vals-iter vals (cdr vals-iter))
                accum)
               ((null vars-iter) accum)
             (push (list (car vars-iter) (car vals-iter)) accum))))
    `(prog T ,vars-vals
       ,@(nreverse (cdr (reverse body)))
       (return-from T ,@(last body)))))

;the following handle all of the complex fexprs by expanding them
;out as macros.  Note that these expansions do not produce any
;of the K* things.  this is a nice modularity.

(defun (:property or k*expander) (forms)
  `(or-lexpr ., (cdr forms)))
(defun (:property and k*expander) (forms)
  `(and-lexpr ., (cdr forms)))

