(defun (:property progn k*expander) (form)
  `(prog T ()
     ,@(nreverse (cdr (reverse (cdr form))))
     (return-from T ,@(last (cdr form)))))

(defun (:property prog1 k*expander) (form)
  (cond ((< (length form) 2)
         (barf "Too few args to PROG1~% Form: ~:=" form)))
  `(prog T (_ret)
     (setq _ret ,(cadr form))
     ,@(cddr form)
     (return-from T _ret)))

(defun (prog2 k*expander) (form)
  (cond ((< (length form) 3)
         (barf "Too few args to PROG2~% Form: ~:=" form)))
  `(prog T (_ret)
     ,(cadr form)
     (setq _ret ,(caddr form))
     ,@(cdddr form)
     (return-from T _ret)))

(defun (:property return k*expander) (form)
  `(return-from nil ,@(cdr form)))

(defun (:property values k*expander) (form)
  `(return-from nil ,@(cdr form)))

(defun (values-list k*expander) (form)
 `(return-list ,@(cdr form)))

;;; only works for short lists at the moment.
(defun (return-list k*expander) (form)
  `(return-from nil
     ,@(do ((expr-iter (cdr form) (cdr expr-iter))
            (fn-iter '(car cadr caddr cadddr) (cdr fn-iter))
            (result nil))
           ((null expr-iter) result)
         (push `(,(car fn-iter) ,(car expr-iter)) result))))

(defun (prog k*expander) (list)
  (cond ((and (cadr list) (symbolp (cadr list)))
         `(kbe-prog-named ,@(cdr list)))
        (T `(kbe-prog-named nil ,@(cdr list)))))

(defun (prog* k*expander) (list)
  (cond ((and (cadr list) (symbolp (cadr list)))
         `(let* ,(caddr list)
            (kbe-prog-named ,(cadr list) nil ,@(cdddr list))))
        (T `(let* ,(cadr list)
              (kbe-prog-named nil nil ,@(cddr list))))))

;If you use any funny prog then all bets are off because we have no idea
;what vars are bound.

(defun (progv k*expander) (list)
  (barf "Cannot use PROGV.~% Data: ~S" list))

(defun (progw k*expander) (list)
  (barf "Cannot use PROGW.~% Data: ~S" list))

(defun (let k*expander) (list)
  (let* (vars forms)
    (do ((pairs (cadr list) (cdr pairs))) ((null pairs))
      (cond ((not (listp (car pairs)))
             (push (car pairs) vars) (push nil forms))
            (T (push (caar pairs) vars) (push (cadar pairs) forms))))
    `((lambda ,(nreverse vars) ,@(cddr list)) ,@(nreverse forms))))

(defun (let* k*expander) (list)
  (let* ((pairs (cadr list)) (body (cddr list)))
    (cond ((null (cdr pairs)) `(let ,pairs ,@body))
          (T `(let (,(car pairs)) (let* ,(cdr pairs) ,@body))))))

(defun (let-if k*expander) (list)
  (let* ((pred (cadr list)) vars forms)
    (do ((pairs (caddr list) (cdr pairs))) ((null pairs))
      (cond ((not (listp (car pairs)))
             (push (car pairs) vars) (push nil forms))
            (T (push (caar pairs) vars) (push (cadar pairs) forms))))
    (cond ((null vars) `(progn ,@(cdddr list)))
          (T `(let ,(mapcar #'list vars vars)
                (cond (,pred (psetq ,@(mapcan #'list vars forms))))
                ,@(cdddr list))))))

(defun (multiple-value-bind k*expander) (list)
  (let* ((vars (second list))
         (form (third list))
         (body (rest3 list))
         (var (gensym)))
    `(let ((,var ,form) ,@vars) (multiple-value ,vars ,var) ,@body)))

(defun (multiple-value k*expander) (list)
  (barf "MULTIPLE-VALUE not supported yet.~% Data: ~S" list))

(defun (do k*expander) (list)
  (cond ((and (cadr list) (symbolp (cadr list)))
         (s-old-style-do-macro nil (cdr list)))
        (T (s-do-macro nil (cdr list)))))

(defun (do-named k*expander) (list)
  (cond ((and (caddr list) (symbolp (caddr list)))
         (s-old-style-do-macro (ncons (cadr list)) (cddr list)))
        (T (s-do-macro (ncons (cadr list)) (cddr list)))))

(defun s-old-style-do-macro (name insides)
  (let* ((var (first insides))
         (init (second insides))
         (repeat (third insides))
         (end-test (fourth insides))
         (body (rest4 insides))
         (tag (gensym)))
    `(let ((,var ,init))
       (prog ,@name nil
         ,tag (cond (,end-test (return nil)))
              ,@body
              (setq ,var ,repeat)
              (go ,tag)))))

(defun s-do-macro (name insides)
  (let* ((triples (first insides))
         (end-list (second insides))
         (body (rest2 insides))
         (end-test (car end-list))
         (exit-forms (cond ((null (cdr end-list)) nil)
                           ((null (cddr end-list)) (cadr end-list))
                           (T `(progn ,@(cdr end-list)))))
         (bindings (mapcar #'(lambda (x)
                               (cond ((not (and (listp x) (cddr x))) x)
                                     (T `(,(car x) ,(cadr x)))))
                           triples))
         (updates (mapcan #'(lambda (x)
                              (cond ((and (listp x) (cddr x))
                                     `(,(car x) ,(caddr x)))))
                          triples))
         (tag (gensym)))
    `(let ,bindings
       (prog ,@name nil
         ,@(cond (end-list (ncons tag)))
              ,@(cond (end-test
                        `((cond (,end-test (return ,exit-forms))))))
              ,@body
              ,@(cond (updates `((psetq ,@updates))))
              ,@(cond (end-list `((go ,tag))))))))

;;; Mapping functions.

;;; These try and generate safe but good names for the loop variables so
;;; the coder will have a good hint.  We only have a good idea what the
;;; names should be if there is a lambda fn with args to look at.

(defun 6mapvars (fn number-args)
  (cond ((6lambda-like-fn? fn)
         (let* ((arglist (arglist fn)))
           (cond ((= (length arglist) number-args)
                  (mapcar #'(lambda (var)
                              (let ((plural (symbol-pluralize var))
                                    (listed (symbolconc var '-LIST)))
                                (cond ((6good-code plural) plural)
                                      ((6good-code listed) listed)
                                      (t (gensym '_)))))
                          arglist))
                 (t (barf "Wrong number of args to lambda")))))
        (t
         (do ((i 0 (1+ i)) list)
             ((= i number-args) list)
           (push (gensym '_) list)))))

(defun 6savevar (var)
  (let* ((saved (symbolconc var '-SAVED)))
    (cond ((6good-code saved) saved)
          ((6good-code 'saved) 'saved)
          ((6good-code 'old) 'old)
          (t (gensym '_)))))

(defun 6resultvar ()
  (cond ((6good-code 'result) 'result)
        ((6good-code 'list) 'list)
        ((6good-code 'value) 'value)
        (t (gensym '_))))

;;; This is a macro for defining k*expanders for map, maplist, etc.
;;; return is memq '(2nd-arg list nconc); apply is memq '(cdr car).
(defmacro def-map-k*expander (name return apply)
  `(defun (:property ,name k*expander) (call)
     (let* ((quoted-function (cadr call))
            (function
              (cond ((memq (car quoted-function) '(quote function))
                     (cadr quoted-function))
                    (t (barf
                         "~S can't handle unquoted function application~
                         ~% Data: ~:="
                         (car call) call))))
            (list-exprs (cddr call))
            (mapvars (6mapvars function (length list-exprs)))
            (returnvar ,(cond ((eq return '2nd-arg)
                               '(6savevar (car mapvars)))
                              (t '(6resultvar))))
            (inits (do ((mapvar-iter mapvars (cdr mapvar-iter))
                        (list-exprs-iter list-exprs (cdr list-exprs-iter))
                        inits)
                       ((null mapvar-iter) `(setq ,@inits))
                     (setq inits
                           (append inits
                                   (list (car mapvar-iter)
                                         (car list-exprs-iter))))))
            (end-test (do ((mapvar-iter mapvars (cdr mapvar-iter))
                           ends)
                          ((null mapvar-iter)
                           `(cond ((or ,@ends) (return ,returnvar))))
                        (push `(null ,(car mapvar-iter)) ends)))
            (repeats (do ((mapvar-iter mapvars (cdr mapvar-iter))
                          repeats)
                         ((null mapvar-iter) `(setq ,@repeats))
                       (setq repeats
                             (append repeats
                                     (list (car mapvar-iter)
                                           `(cdr ,(car mapvar-iter)))))))
            (inner-application
              (selectq ',apply
                (car `(,function
                       ,@(do ((mapvar-iter mapvars (cdr mapvar-iter))
                              cars)
                             ((null mapvar-iter) (nreverse cars))
                           (push `(car ,(car mapvar-iter)) cars))))
                (cdr `(,function ,@mapvars))))
            (application
              (selectq ',return
                (2nd-arg inner-application)
                (list `(setq ,returnvar
                             (append ,returnvar
                                     (ncons ,inner-application))))
                (nconc `(setq ,returnvar
                              (nconc ,returnvar
                                     (ncons ,inner-application))))))
            (return-init
              (selectq ',return
                (2nd-arg `((setq ,returnvar ,(car mapvars))))
                ((list nconc) nil))))
       `(prog (,@mapvars ,returnvar)
              ,inits
              ,@return-init
           _1 ,end-test
              ,application
              ,repeats
              (go _1)))))

(def-map-k*expander map 2nd-arg cdr)
(def-map-k*expander mapc 2nd-arg car)
(def-map-k*expander maplist list cdr)
(def-map-k*expander mapcar list car)
(def-map-k*expander mapcon nconc cdr)
(def-map-k*expander mapcan nconc car)

;this is stuff for expanding cobol programs.

(defun (cobol-fn k*expander) (form)
  `(kbe-prog-named nil ,(Rlist  [(Elist (cadr form)) ['quote 'undefined]])
     .,(cddr form)))

(defun (pif k*expander) (form)
  `(k*if ., (cdr form)))

(defun (stop k*expander) (ignore) '(return))

(defun (stop-run k*expander) (ignore) '(return))

(defun (goback k*expander) (ignore) '(return))
