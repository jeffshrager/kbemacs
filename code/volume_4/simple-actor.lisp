;;; SIMPLE-ACTOR: A description of the Simple-Actor's behavior.

;;; The Simple Actor
;;; SIMPLE-ACTOR
;;; A simple-actor is a command interface.
;;; It has a typein window and a menu window for command input.
;;; It has remark and presentation windows for display of results.
(defflavor simple-actor ((focus-info nil))
  (employer-mixin standard-actor)
  :initable-instance-variables
  :settable-instance-variables
  :gettable-instance-variables
  (:default-init-plist
      :window-flavor 'simple-frame) )
(define-system-initialization simple-actor
  (make-instance 'simple-actor))

;;; Idiosyncratic Behaviors
;;; SUGGEST-FOCUS reference-list paths        :
;;; This tries  to change the focus in the window.
(define-behavior (simple-actor suggest-focus) (data)
  (setq focus-info data)              ;cache for later
  (send (my typeout-window) ':change-focus
        (get (locf data) ':reference)
        (cons (get (locf data) ':name)
              (get (locf data) ':paths))))
;;; CODER-CONFIRMATION
;;; This handles code generated by the apprentice.
;;; If the code is different than previously believed, the
;;; belief structure is updated and the new code is displayed.
;;; If this happens, the focus is also invalidated.
(define-behavior (simple-actor coder-confirmation) (fn code)
  (let ((w (my typeout-window))
        (old-code (send self ':belief ':code fn)))
    (when (not (code-equal old-code code))    ; Only if code has changed...
      (if (eq fn (car (send w ':focus)))      ; Invalidate any display...
          (send w ':set-focus nil))
      (send self ':believe ':code fn code))))
(define-interpretation (simple-actor clear) ()
  (send (my typeout-window) ':clear-screen))

;;; Initialization       :
;;; Request compile-time compilation of flavors. By default, the
;;; methods would not get compiled until fasload-time otherwise.
(compile-flavor-methods simple-actor)
